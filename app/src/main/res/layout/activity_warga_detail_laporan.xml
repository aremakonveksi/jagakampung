<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lp_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvJudul"
            style="@style/LpJudulHalaman"
            android:text="Detail Laporan" />

        <TextView
            android:id="@+id/tvInfo"
            style="@style/LpSubJudul"
            android:layout_marginTop="6dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/lp_bg_badge"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            style="@style/LpLabel"
            android:layout_marginTop="24dp"
            android:text="Deskripsi" />

        <TextView
            android:id="@+id/tvDeskripsi"
            style="@style/LpSubJudul"
            android:textColor="@color/lp_text" />

        <TextView
            style="@style/LpLabel"
            android:text="Lokasi" />

        <TextView
            android:id="@+id/tvLokasi"
            style="@style/LpSubJudul"
            android:textColor="@color/lp_text" />

        <TextView
            style="@style/LpLabel"
            android:text="Foto" />

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Foto laporan"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFotoKosong"
            style="@style/LpSubJudul"
            android:text="Tidak ada foto"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnKembali"
            style="@style/LpTombolOutline"
            android:layout_marginTop="28dp"
            android:text="Kembali" />
    </LinearLayout>
</ScrollView>