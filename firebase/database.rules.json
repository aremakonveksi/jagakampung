{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('peran').val() === 'admin' || root.child('users').child(auth.uid).child('status').val() === 'approved')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('peran').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['nama','email','peran','status'])",
        "nama": { ".validate": "newData.val() is string && newData.val().length > 0 && newData.val().length <= 60" },
        "email": { ".validate": "newData.val() is string && newData.val().length <= 120" },
        "rt": { ".validate": "newData.val() is string" },
        "rw": { ".validate": "newData.val() is string" },
        "peran": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.val() === 'warga'"
        },
        "status": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('users').child(auth.uid).child('peran').val() === 'admin')",
          ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'"
        },
        "dibuatPada": { ".validate": "newData.val() is number" },
        "alasanTolak": { ".validate": "newData.val() is string" }
      }
    },
    "laporan": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
      "$id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
        ".create": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && newData.child('uidPelapor').val() === auth.uid && newData.child('status').val() === 'dilaporkan'",
        ".update": "auth != null && (root.child('users').child(auth.uid).child('peran').val() === 'admin' || (newData.child('uidPelapor').val() === auth.uid && data.child('status').val() === 'dilaporkan'))",
        ".delete": "auth != null && root.child('users').child(auth.uid).child('peran').val() === 'admin'",
        ".validate": "newData.hasChildren(['uidPelapor','judul','deskripsi','kategori','status'])",
        "uidPelapor": { ".validate": "newData.val() === auth.uid" },
        "namaPelapor": { ".validate": "newData.val() is string" },
        "judul": { ".validate": "newData.val() is string && newData.val().length >= 3 && newData.val().length <= 100" },
        "deskripsi": { ".validate": "newData.val() is string && newData.val().length <= 2000" },
        "kategori": { ".validate": "newData.val() is string && newData.val().length <= 40" },
        "alamatTeks": { ".validate": "newData.val() is string" },
        "lat": { ".validate": "newData.val() is number" },
        "lng": { ".validate": "newData.val() is number" },
        "status": {
          ".validate": "newData.val() === 'dilaporkan' || newData.val() === 'ditinjau' || newData.val() === 'diproses' || newData.val() === 'selesai'"
        },
        "dibuatPada": { ".validate": "newData.val() is number" },
        "diperbaruiPada": { ".validate": "newData.val() is number" }
      }
    },
    "laporanFoto": {
      "$id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && !data.exists()",
        ".validate": "newData.isString() && newData.val().length <= 1000000"
      }
    },
    "tanggapan": {
      "$laporanId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
        "$tanggapanId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('peran').val() === 'admin' && root.child('users').child(auth.uid).child('status').val() === 'approved'",
          ".validate": "newData.hasChildren(['uidAdmin','teks','statusBaru'])",
          "uidAdmin": { ".validate": "newData.val() === auth.uid" },
          "teks": { ".validate": "newData.val() is string && newData.val().length <= 1000" },
          "statusBaru": {
            ".validate": "newData.val() === 'ditinjau' || newData.val() === 'diproses' || newData.val() === 'selesai'"
          },
          "dibuatPada": { ".validate": "newData.val() is number" }
        }
      }
    }
  }
}
