{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('peran').val() === 'admin' || root.child('users').child(auth.uid).child('status').val() === 'approved')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('peran').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['nama','email','peran','status'])",
        "nama": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "rt": {
          ".validate": "newData.isString()"
        },
        "rw": {
          ".validate": "newData.isString()"
        },
        "peran": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.val() === 'warga'"
        },
        "status": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('users').child(auth.uid).child('peran').val() === 'admin')",
          ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'"
        },
        "dibuatPada": {
          ".validate": "newData.isNumber()"
        },
        "alasanTolak": {
          ".write": "auth != null && (auth.uid === $uid && !data.exists() || root.child('users').child(auth.uid).child('peran').val() === 'admin')",
          ".validate": "newData.isString()"
        }
      }
    },
    "laporan": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
      "$id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
        ".validate": "newData.hasChildren(['uidPelapor','judul','deskripsi','kategori','status'])",
        "uidPelapor": {
          ".validate": "newData.val() === auth.uid"
        },
        "namaPelapor": {
          ".validate": "newData.isString()"
        },
        "judul": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 100"
        },
        "deskripsi": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "kategori": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "alamatTeks": {
          ".validate": "newData.isString()"
        },
        "lat": {
          ".validate": "newData.isNumber()"
        },
        "lng": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.val() === 'dilaporkan' || newData.val() === 'ditinjau' || newData.val() === 'diproses' || newData.val() === 'selesai' || newData.val() === 'ditolak'"
        },
        "dibuatPada": {
          ".validate": "newData.isNumber()"
        },
        "diperbaruiPada": {
          ".validate": "newData.isNumber()"
        },
        ".write": "auth != null && ((!data.exists() && auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && newData.child('uidPelapor').val() === auth.uid && newData.child('status').val() === 'dilaporkan') || (data.exists() && ((!newData.exists() && auth != null && root.child('users').child(auth.uid).child('peran').val() === 'admin') || (newData.exists() && auth != null && (root.child('users').child(auth.uid).child('peran').val() === 'admin' || (newData.child('uidPelapor').val() === auth.uid && data.child('status').val() === 'dilaporkan'))))))"
      },
      ".indexOn": [
        "uidPelapor"
      ]
    },
    "laporanFoto": {
      "$id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && !data.exists()",
        ".validate": "newData.isString() && newData.val().length <= 1000000"
      }
    },
    "tanggapan": {
      "$laporanId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
        "$tanggapanId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('peran').val() === 'admin' && root.child('users').child(auth.uid).child('status').val() === 'approved'",
          ".validate": "newData.hasChildren(['uidAdmin','teks','statusBaru'])",
          "uidAdmin": {
            ".validate": "newData.val() === auth.uid"
          },
          "teks": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "statusBaru": {
            ".validate": "newData.val() === 'ditinjau' || newData.val() === 'diproses' || newData.val() === 'selesai' || newData.val() === 'ditolak'"
          },
          "dibuatPada": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
