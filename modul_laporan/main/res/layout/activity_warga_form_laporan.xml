<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lp_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/LpJudulHalaman"
            android:text="Buat Laporan" />

        <TextView
            style="@style/LpSubJudul"
            android:layout_marginTop="8dp"
            android:text="Ceritakan masalah di lingkunganmu" />

        <TextView
            style="@style/LpLabel"
            android:text="Judul" />

        <EditText
            android:id="@+id/etJudul"
            style="@style/LpInput"
            android:hint="Contoh: Lampu jalan mati"
            android:inputType="textCapSentences"
            android:maxLength="80" />

        <TextView
            style="@style/LpLabel"
            android:text="Deskripsi" />

        <EditText
            android:id="@+id/etDeskripsi"
            style="@style/LpInput"
            android:gravity="top"
            android:hint="Jelaskan kejadiannya"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4" />

        <TextView
            style="@style/LpLabel"
            android:text="Kategori" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/lp_bg_input"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/spKategori"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/lp_kategori" />
        </LinearLayout>

        <TextView
            style="@style/LpLabel"
            android:text="Alamat (opsional)" />

        <EditText
            android:id="@+id/etAlamat"
            style="@style/LpInput"
            android:hint="Contoh: Gang 3, RT 02"
            android:inputType="textCapWords" />

        <TextView
            style="@style/LpLabel"
            android:text="Lokasi GPS (opsional)" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLokasi"
            style="@style/LpTombolOutline"
            android:text="Ambil lokasi GPS" />

        <TextView
            android:id="@+id/tvLokasi"
            style="@style/LpSubJudul"
            android:layout_marginTop="8dp"
            android:text="Lokasi belum diambil"
            android:textSize="14sp" />

        <TextView
            style="@style/LpLabel"
            android:text="Foto (opsional)" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFoto"
            style="@style/LpTombolOutline"
            android:text="Ambil foto dari kamera" />

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Pratinjau foto laporan"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnKirim"
            style="@style/LpTombol"
            android:layout_marginTop="28dp"
            android:text="Kirim laporan" />
    </LinearLayout>
</ScrollView>